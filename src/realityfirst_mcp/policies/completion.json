{
  "schema": "realityfirst.completion-gates.v1",
  "gates": {
    "file_written": [
      "readback",
      "hash_or_stat"
    ],
    "file_deleted": [
      "absence_check"
    ],
    "build_completed": [
      "terminal_receipt",
      "artifact_stat"
    ],
    "tests_passed": [
      "test_receipt_or_terminal_receipt"
    ],
    "deployment_completed": [
      "runtime_probe",
      "terminal_receipt"
    ],
    "runtime_changed": [
      "runtime_probe"
    ]
  },
  "rule": "A model report is candidate evidence, never sufficient completion proof by itself."
}
